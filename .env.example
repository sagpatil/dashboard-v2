# Settings (all optional). Copy to .env.local, which both the API server
# (npm run dev / npm start) and Vite read, or set them in the environment.
# PORT=8787
# HOST=0.0.0.0
# LOG_LEVEL=info
# HORIZON_MAINNET_URL=https://horizon.stellar.org
# HORIZON_TESTNET_URL=https://horizon-testnet.stellar.org
# DASHBOARD_API_URL=https://dashboard.stellar.org
# STATUSPAGE_API_URL=https://9sl3dhr1twv1.statuspage.io
# LEDGER_FEEDS=mainnet,testnet
# UPSTREAM_TIMEOUT_MS=10000
# STATIC_DIR=./dist      (empty string = API only)
# CORS_ORIGINS=https://dashboard.example.com
# TRUST_PROXY=false      (true, a hop count such as 1, or proxy IPs/CIDR ranges)
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000
# MAX_STREAM_CLIENTS=2000
# MAX_STREAMS_PER_IP=20
# ALLOWED_ACCOUNTS=GAIH3ULLFQ4DGSECF2AR555KZ4KNDGEKN4AFI4SU2M7B43MGK3QJZNSR
# METRICS_ENABLED=true
# METRICS_TOKEN=
# SHUTDOWN_TIMEOUT_MS=10000

# Frontend build setting: API origin when the app is hosted elsewhere
# VITE_API_BASE_URL=https://api.dashboard.example.com
